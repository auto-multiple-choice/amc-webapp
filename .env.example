# Settings for the AMC web app. The launcher (./amc or amc.cmd) writes .env
# on first run with values like these; edit .env, then run `amc restart`.

# Port the web app is served on: http://localhost:8090
# (https://localhost:8090 in shared-machine mode)
AMC_PORT=8090

# Which network addresses can reach the app.
#   127.0.0.1  this computer only (default; use until login is set up)
#   0.0.0.0    every computer on the network
# `./amc login on` sets 0.0.0.0 (or 127.0.0.1 with --local) and
# `./amc login off` sets 127.0.0.1; edit it afterwards if you need to.
AMC_BIND=127.0.0.1

# Folder holding the exam projects (MC-Projects/) and AMC settings (.AMC.d/).
# Use an absolute path; forward slashes work on Windows too (C:/Users/me/AMC-Web).
AMC_DATA_DIR=/home/me/AMC-Web

# User and group the app runs as. The launcher sets these to your own user
# on Linux; leave them unset on macOS and Windows.
#AMC_UID=1000
#AMC_GID=1000

# Time zone (IANA name), used for timestamps and the nightly temp-file cleanup.
TZ=UTC

# Server log detail: ERROR, WARNING, INFO or DEBUG.
AMC_SERVER_LOGGING=INFO

# --- Shared-machine mode (./amc login on / off manages these) ---------------
# Sign-in, HTTPS and one projects folder per teacher.
#AMC_LOGIN=1
#COMPOSE_PATH_SEPARATOR=,
#COMPOSE_FILE=docker-compose.yml,docker-compose.override.yml,compose.login.yml
# (`./amc printer on` appends compose.printer.yml to this list.)

# Extra names colleagues use to reach this machine, for the HTTPS
# certificate (localhost, the LAN address and the computer name are added
# automatically). Comma separated, e.g. amc.myschool.lan
#AMC_HOSTNAMES=

# Accounts that can open every teacher's projects (comma separated).
# Empty: each teacher sees only their own.
#AMC_ADMINS=

# The app stops in shared-machine mode if the sandbox that keeps teachers'
# projects apart doesn't work on this machine. Set to 1 to run anyway when
# you trust every teacher (the launcher then starts the app with
# AMC_ISOLATE=0, which turns the sandbox off).
#AMC_ALLOW_UNISOLATED=0

# --- Public server (./amc public on HOST / off manages these) ---------------
# The app at https://HOST through a Cloudflare Tunnel (compose.tunnel.yml,
# added to COMPOSE_FILE). Needs shared-machine mode; AMC_BIND stays
# 127.0.0.1. See doc/public-hosting.md.
#AMC_PUBLIC_HOST=amc.example.org
# The tunnel's token: whoever has it can run the tunnel, so keep .env
# private (the launcher makes it readable by you only).
#AMC_TUNNEL_TOKEN=
# Memory and processors the app may use on a public server (other services
# usually share the machine). Docker's notation: 1536m, 2g; 1.5 processors.
#AMC_MEMORY=2g
#AMC_CPUS=2

# --- Direct printing (./amc printer on / off manages these) -----------------
# Linux shared machines only: the app prints through this machine's print
# system (CUPS). Elsewhere teachers save the PDFs and print them anywhere.
#AMC_PRINTER=1
#AMC_CUPS_SOCKET=/run/cups/cups.sock
