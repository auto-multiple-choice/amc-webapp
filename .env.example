# Settings for the AMC web app. The launcher (./amc or amc.cmd) creates
# .env from these defaults on first run; edit .env, then run `amc restart`.

# Port the web app is served on: http://localhost:8090
AMC_PORT=8090

# Which network addresses can reach the app.
#   127.0.0.1  this computer only (default; use until login is set up)
#   0.0.0.0    every computer on the network
AMC_BIND=127.0.0.1

# Folder holding the exam projects (MC-Projects/) and AMC settings (.AMC.d/).
# Use an absolute path; forward slashes work on Windows too (C:/Users/me/AMC-Web).
AMC_DATA_DIR=/home/me/AMC-Web

# User and group the app runs as. The launcher sets these to your own user
# on Linux; leave them unset on macOS and Windows.
#AMC_UID=1000
#AMC_GID=1000

# Time zone (IANA name), used for timestamps and the nightly temp-file cleanup.
TZ=UTC

# Server log detail: ERROR, WARNING, INFO or DEBUG.
AMC_SERVER_LOGGING=INFO
