#!/usr/bin/env bash
# AMC web app launcher for macOS and Linux (on Windows, use amc.cmd).
# Run `./amc help` for the list of commands.
#
# Keep this file working with bash 3.2, the version macOS ships.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

SERVICE=amc-web          # service name in docker-compose.yml
IMAGE=amc-web            # image name in docker-compose.yml
MIN_COMPOSE=2.24.4       # first version supporting `!override`
LOGIN_FILES=docker-compose.yml,docker-compose.override.yml,compose.login.yml
TUNNEL_FILE=compose.tunnel.yml   # public server mode (./amc public on)

if [ -t 1 ]; then
  B=$'\033[1m'; RED=$'\033[31m'; YEL=$'\033[33m'; GRN=$'\033[32m'; N=$'\033[0m'
else
  B=; RED=; YEL=; GRN=; N=
fi
say()  { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '%sOK%s  %s\n' "$GRN" "$N" "$*"; }
warn() { printf '%sWarning:%s %s\n' "$YEL" "$N" "$*" >&2; }
die()  { printf '%sError:%s %s\n' "$RED" "$N" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
AMC web app launcher

Usage: ./amc <command> [options]

Commands:
  start [--no-open]    Build if needed, start the app and open it in the browser
  stop                 Stop the app (projects are kept)
  restart [--no-open]  Stop, then start (needed after editing .env)
  status               Show whether the app is running, and where
  logs                 Follow the server log (Ctrl+C to quit)
  open                 Open the app in the browser
  update [--no-open]   Pull the latest version of this repository, then restart
  import [--user NAME] <folder>...
                       Copy existing AMC project folders into the app

Shared machine (sign-in, HTTPS, one projects folder per teacher):
  login on [--local]   Turn it on; --local keeps it reachable from this computer only
  login off            Back to this computer only, without sign-in
  user add NAME [--admin] [--temporary]
                       Create an account (--admin: can manage accounts;
                       --temporary: print a starting password to change at sign-in)
  user passwd NAME     Set an account's password
  user list            List accounts
  user enable NAME     Re-enable a disabled account
  cert                 Show how browsers can trust the app's HTTPS certificate

Public server (a web address such as https://amc.example.org, through a
Cloudflare Tunnel; see doc/public-hosting.md):
  public on HOST       Serve the app at https://HOST (asks for the tunnel token;
                       turns on sign-in, keeps the server's port 127.0.0.1-only)
  public off           Stop serving the public address
  public status        Show the public address and whether the tunnel is up

  printer on|off|status
                       Print directly on this machine's printers (Linux only;
                       elsewhere teachers save PDFs and print them anywhere)

  backup               Save all projects (and, on a shared machine, accounts and
                       the certificate authority) to AMC_DATA_DIR/backups

  help                 Show this help

Settings are in .env, created on first start (see .env.example).
EOF
}

# --- settings ---------------------------------------------------------------

# env_get KEY DEFAULT: value of KEY in .env, or DEFAULT.
env_get() {
  local line
  line=$(grep -E "^[[:space:]]*$1=" .env 2>/dev/null | tail -n 1 || true)
  if [ -z "$line" ]; then printf '%s' "$2"; return 0; fi
  line=${line#*=}
  line=${line%$'\r'}
  line=${line%\"}; line=${line#\"}
  line=${line%\'}; line=${line#\'}
  printf '%s' "$line"
}

# env_set KEY VALUE: set KEY in .env, keeping every other line.
env_set() {
  local tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/amc-env.XXXXXX")
  awk -v k="$1" -v v="$2" '
    $0 ~ "^[[:space:]]*" k "=" { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }' .env > "$tmp"
  cat "$tmp" > .env
  rm -f "$tmp"
}

env_unset() {
  local tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/amc-env.XXXXXX")
  awk -v k="$1" '$0 !~ "^[[:space:]]*" k "=" { print }' .env > "$tmp"
  cat "$tmp" > .env
  rm -f "$tmp"
}

detect_tz() {
  local tz=""
  if [ -L /etc/localtime ]; then
    tz=$(readlink /etc/localtime | sed -n 's|.*zoneinfo/||p')
  elif [ -r /etc/timezone ]; then
    tz=$(head -n 1 /etc/timezone)
  fi
  printf '%s' "${tz:-UTC}"
}

# The user who should own the data, even when run with sudo on Linux.
real_home() {
  if [ -n "${SUDO_USER:-}" ] && command -v getent >/dev/null 2>&1; then
    getent passwd "$SUDO_USER" | cut -d: -f6
  else
    printf '%s' "$HOME"
  fi
}

# mkdir -p that, under sudo, gives the new folders to the real user: the app
# runs as that user (AMC_UID) and must be able to write in them.
make_dirs() {
  local d
  for d in "$@"; do
    [ -d "$d" ] && continue
    mkdir -p "$d" || die "Could not create $d"
    if [ -n "${SUDO_UID:-}" ] && [ "$(id -u)" = 0 ]; then
      chown "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" "$d" 2>/dev/null || true
    fi
  done
}

ensure_env() {
  [ -f .env ] && return 0
  say "First run: writing settings to .env"
  {
    echo "# AMC web app settings (see .env.example). Run ./amc restart after editing."
    echo "AMC_PORT=8090"
    echo "AMC_BIND=127.0.0.1"
    echo "AMC_DATA_DIR=$(real_home)/AMC-Web"
    if [ "$(uname -s)" = Linux ]; then
      echo "AMC_UID=${SUDO_UID:-$(id -u)}"
      echo "AMC_GID=${SUDO_GID:-$(id -g)}"
    fi
    echo "TZ=$(detect_tz)"
    echo "AMC_SERVER_LOGGING=INFO"
  } > .env
  if [ -n "${SUDO_UID:-}" ] && [ "$(id -u)" = 0 ]; then
    chown "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" .env 2>/dev/null || true
  fi
}

load_settings() {
  PORT=$(env_get AMC_PORT 8090)
  BIND=$(env_get AMC_BIND 127.0.0.1)
  DATA_DIR=$(env_get AMC_DATA_DIR "")
  case $PORT in ''|*[!0-9]*) die "AMC_PORT in .env must be a number (got '$PORT')." ;; esac
  case $DATA_DIR in
    /*) ;;
    '') die "AMC_DATA_DIR is not set in .env." ;;
    *)  die "AMC_DATA_DIR in .env must be an absolute path (got '$DATA_DIR')." ;;
  esac
  PUBLIC_HOST=$(env_get AMC_PUBLIC_HOST "")
  if public_mode; then
    URL="https://$PUBLIC_HOST"
  elif login_mode; then
    URL="https://localhost:$PORT"
  else
    URL="http://localhost:$PORT"
  fi
}

login_mode() { [ "$(env_get AMC_LOGIN 0)" = 1 ]; }
# Public server mode needs sign-in: a public address without it is never used.
public_mode() { login_mode && [ -n "$(env_get AMC_PUBLIC_HOST "")" ]; }

# --- docker -----------------------------------------------------------------

# version_ge A B: true when version A >= version B.
version_ge() {
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)" = "$2" ]
}

ensure_docker() {
  command -v docker >/dev/null 2>&1 ||
    die "Docker is not installed. Get Docker Desktop (macOS) or Docker Engine (Linux): https://docs.docker.com/get-docker/"
  docker compose version >/dev/null 2>&1 ||
    die "The 'docker compose' command is missing. Install Docker Compose v2: https://docs.docker.com/compose/install/"

  if ! docker info >/dev/null 2>&1; then
    case "$(uname -s)" in
      Darwin)
        say "Starting Docker Desktop..."
        open -a Docker 2>/dev/null || die "Could not start Docker Desktop. Start it from Applications, then try again."
        local i=0
        until docker info >/dev/null 2>&1; do
          i=$((i + 1))
          [ "$i" -le 90 ] || die "Docker Desktop did not start within 3 minutes."
          sleep 2
        done
        ;;
      *)
        if docker info 2>&1 | grep -qi 'permission denied'; then
          die "Your user can't use Docker. Run 'sudo usermod -aG docker \$USER', log out and back in, then try again."
        fi
        die "Docker is not running. Start it with: sudo systemctl start docker"
        ;;
    esac
  fi

  local v
  v=$(docker compose version --short 2>/dev/null | sed 's/^v//')
  v=${v%%[-+]*}
  version_ge "$v" "$MIN_COMPOSE" ||
    die "Docker Compose $v is too old; $MIN_COMPOSE or newer is needed. Please update Docker."
}

is_running() { [ -n "$(docker compose ps --status running -q "$1" 2>/dev/null)" ]; }

# Host port the app is published on right now, or nothing.
published_port() {
  if login_mode; then
    docker compose port caddy "$PORT" 2>/dev/null | sed 's/.*://' || true
  else
    docker compose port "$SERVICE" 8080 2>/dev/null | sed 's/.*://' || true
  fi
}

# port_in_use PORT: true (and prints who, if known) when something answers on it.
port_in_use() {
  local who="" rc4=0 rc6=0
  if command -v lsof >/dev/null 2>&1; then
    who=$(lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR > 1 {print $1 " (pid " $2 ")"}' | sort -u | paste -sd ',' - | sed 's/,/, /g' || true)
  fi
  if command -v curl >/dev/null 2>&1; then
    curl -s -m 2 -o /dev/null "http://127.0.0.1:$1/" || rc4=$?
    curl -s -m 2 -o /dev/null -g "http://[::1]:$1/" || rc6=$?
    # 7 = connection refused, i.e. nothing is listening.
    if [ "$rc4" -eq 7 ] && [ "$rc6" -eq 7 ] && [ -z "$who" ]; then return 1; fi
  elif [ -z "$who" ]; then
    return 1
  fi
  printf '%s' "${who:-another program}"
}

# --- helpers ----------------------------------------------------------------

write_version() {
  command -v git >/dev/null 2>&1 || return 0
  local v line f=server/version.py
  v=$(git describe --tags --always --dirty 2>/dev/null || true)
  [ -n "$v" ] || return 0
  line="APP_VERSION=\"$v\""
  if [ -f "$f" ] && [ "$(cat "$f")" = "$line" ]; then return 0; fi
  printf '%s\n' "$line" > "$f"
}

# The image copies the app files with their permissions from this folder.
# When the app runs as a user other than the image's own (uid 1000, set via
# AMC_UID on Linux), it can only read files that everyone may read, which a
# checkout made with a strict umask, or on an exFAT/NTFS drive, doesn't allow.
check_readable() {
  local uid
  uid=$(env_get AMC_UID 1000)
  [ "$uid" = 1000 ] && return 0
  if [ -n "$(find server src-icons Makefile requirements.txt \
      \( -type f ! -perm -o=r \) -o \( -type d ! -perm -o=rx \) 2>/dev/null | head -n 1)" ]; then
    die "Some app files in this folder aren't readable by other users, so the app can't run as uid $uid. Fix it with: chmod -R a+rX \"$ROOT\""
  fi
}

# On exFAT/FAT drives macOS stores file metadata in "._name" twin files, and
# Docker's build fails reading them before .dockerignore is even applied.
# They only hold metadata (such as a download-provenance tag), so drop them.
remove_appledouble() {
  [ "$(uname -s)" = Darwin ] || return 0
  find "$ROOT" -path "$ROOT/.git" -prune -o -name '._*' -type f -exec rm -f {} + 2>/dev/null || true
}

lan_address() {
  case "$(uname -s)" in
    Darwin)
      local ifc
      ifc=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}' || true)
      ipconfig getifaddr "${ifc:-en0}" 2>/dev/null || true
      ;;
    *) hostname -I 2>/dev/null | awk '{print $1}' || true ;;
  esac
}

# Names and addresses the HTTPS certificate must cover: browsers only accept
# the certificate for the exact name or address they connect to.
site_hosts() {
  local h
  echo localhost
  lan_address
  case "$(uname -s)" in
    Darwin) h=$(scutil --get LocalHostName 2>/dev/null || true); [ -z "$h" ] || echo "$h.local" ;;
    *)      hostname 2>/dev/null || true ;;
  esac
  env_get AMC_HOSTNAMES "" | tr ',' ' ' | tr ' ' '\n'
}

# Exports the variables compose.login.yml and the Caddyfile read.
export_sites() {
  local h sites="" origins=""
  for h in $(site_hosts | tr '[:upper:]' '[:lower:]' | grep -E '^[a-z0-9][a-z0-9.-]*$' | awk '!seen[$0]++'); do
    sites="${sites:+$sites, }https://$h:$PORT"
    origins="${origins:+$origins,}https://$h:$PORT"
  done
  # The public address (caddy/tunnel/site.caddy) is reached on the standard
  # HTTPS port, so browsers send it as their origin without a port.
  h=$(env_get AMC_PUBLIC_HOST "")
  if public_mode; then origins="$origins,https://$h"; fi
  LAN_IP=$(lan_address)
  export AMC_SITES="$sites" AMC_ORIGINS="$origins" AMC_DEFAULT_SNI="${LAN_IP:-localhost}"
  # A label on the caddy service (compose.login.yml), so that `up` recreates
  # caddy when its configuration changed (after ./amc update, say): caddy
  # reads it only when it starts.
  AMC_CADDYFILE_HASH=$(cat caddy/Caddyfile caddy/tunnel/*.caddy | cksum | cut -d' ' -f1)
  export AMC_CADDYFILE_HASH
}

wait_ready() {
  local i=0 body
  command -v curl >/dev/null 2>&1 || { sleep 5; return 0; }
  while :; do
    if login_mode; then
      # The sign-in page through caddy, and AMC itself behind it.
      # Caddy only answers for the names it holds certificates for.
      body=$(curl -fsk -m 3 --resolve "localhost:$PORT:127.0.0.1" "https://localhost:$PORT/auth/login" 2>/dev/null || true)
      case $body in
        *'Sign in'*)
          docker compose exec -T "$SERVICE" curl -fs -m 3 http://127.0.0.1:8080/public/status.json >/dev/null 2>&1 && return 0 ;;
      esac
    else
      body=$(curl -fs -m 3 "http://127.0.0.1:$PORT/" 2>/dev/null || true)
      case $body in *'<title>AMC'*) return 0 ;; esac
    fi
    i=$((i + 1))
    if [ "$i" -gt 60 ]; then
      docker compose logs --tail 30 >&2 || true
      die "The app did not answer at $URL within 2 minutes (server log above)."
    fi
    sleep 2
  done
}

# AMC runs each teacher's LaTeX and scoring commands in a sandbox limited to
# their own projects (Landlock). It silently does nothing on a kernel without
# Landlock, and it can't follow files on some shared folders, so check on the
# real projects storage that it lets the allowed folder through and blocks
# the rest.
check_sandbox() {
  local result problem
  if [ "$(env_get AMC_ALLOW_UNISOLATED 0)" = 1 ]; then
    warn "The sandbox between teachers is off (AMC_ALLOW_UNISOLATED=1): a teacher's LaTeX can read other teachers' projects."
    return 0
  fi
  # shellcheck disable=SC2016  # expanded inside the container
  result=$(docker compose exec -T "$SERVICE" sh -c '
    d=/amc-web/files/MC-Projects/.amc-sandbox-check
    mkdir -p $d/ok && echo fine > $d/ok/f && echo secret > $d/secret
    run() { landrun --best-effort --log-level error --rox "$AMC_ISOLATE_ROX" --ro /etc --rw $d/ok -- "$@"; }
    if ! run cat $d/ok/f >/dev/null 2>&1; then echo broken
    elif run cat $d/secret >/dev/null 2>&1; then echo open
    else echo isolated; fi
    rm -rf $d' 2>/dev/null || true)
  case $result in
    isolated) return 0 ;;
    open) problem="The sandbox doesn't isolate anything here: this Linux kernel lacks Landlock (Linux 5.13 or newer, with Landlock enabled). A teacher's LaTeX could read other teachers' projects." ;;
    *)    problem="The sandbox would stop AMC from reading its own projects here (result: '${result:-no answer}')." ;;
  esac
  docker compose down >/dev/null 2>&1 || true
  die "$problem The app was stopped. If you trust every teacher, set AMC_ALLOW_UNISOLATED=1 in .env (this turns the sandbox off) and start again."
}

# Whether cloudflared is connected to Cloudflare. Its readiness address is
# only reachable inside the compose network, so ask from caddy's container.
tunnel_ready() {
  docker compose exec -T caddy wget -q -O /dev/null -T 3 http://cloudflared:2000/ready >/dev/null 2>&1
}

check_tunnel() {
  local i=0
  until tunnel_ready; do
    i=$((i + 1))
    if [ "$i" -ge 30 ]; then
      warn "The Cloudflare tunnel isn't connected yet. Check the token and the log: docker compose logs cloudflared"
      return 0
    fi
    sleep 2
  done
  ok "Connected to Cloudflare"
}

auth_exec() {
  if [ -t 0 ]; then
    docker compose exec amc-auth flask user "$@"
  else
    docker compose exec -T amc-auth flask user "$@"
  fi
}

account_count() {
  docker compose exec -T amc-auth flask user count 2>/dev/null | tr -cd '0-9' || true
}

open_url() {
  case "$(uname -s)" in
    Darwin) open "$1" ;;
    *)
      if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$1" >/dev/null 2>&1 &
      else
        return 1
      fi
      ;;
  esac
}

parse_open_flag() {
  OPEN_BROWSER=1
  local a
  for a in "$@"; do
    case $a in
      --no-open) OPEN_BROWSER=0 ;;
      *) die "Unknown option: $a" ;;
    esac
  done
}

confirm() {
  local reply
  printf '%s [y/N] ' "$1"
  read -r reply || reply=""
  case $reply in y|Y|yes|Yes) return 0 ;; *) return 1 ;; esac
}

print_where() {
  if public_mode; then
    echo "    Address:           https://$PUBLIC_HOST (through the Cloudflare tunnel)"
    echo "    On this server:    https://localhost:$PORT (over SSH, e.g. ssh -L $PORT:localhost:$PORT)"
    echo "    Projects:          in a Docker volume, one folder per teacher (./amc backup exports them)"
  elif login_mode; then
    echo "    On this computer:  $URL"
    if [ "$BIND" != 127.0.0.1 ] && [ -n "${LAN_IP:-}" ]; then
      echo "    Colleagues:        https://$LAN_IP:$PORT"
    elif [ "$BIND" = 127.0.0.1 ]; then
      echo "    Reachable from this computer only (login on --local)."
    fi
    echo "    Projects:          in a Docker volume, one folder per teacher (./amc backup exports them)"
    echo "    Browsers warn about the certificate until they trust it: ./amc cert"
  else
    echo "    Projects folder: $DATA_DIR/MC-Projects"
    if [ "$BIND" = 127.0.0.1 ]; then
      echo "    Reachable from this computer only."
    else
      local ip; ip=$(lan_address)
      [ -n "$ip" ] && echo "    Others on your network: http://$ip:$PORT"
      warn "The app is reachable from the network without sign-in. Use ./amc login on for a shared machine."
    fi
  fi
}

# --- commands ---------------------------------------------------------------

cmd_start() {
  parse_open_flag "$@"
  ensure_docker
  ensure_env
  load_settings
  if login_mode; then
    export_sites
    if [ "$(env_get AMC_ALLOW_UNISOLATED 0)" = 1 ]; then export AMC_ISOLATE=0; fi
  fi
  if public_mode; then
    [ -n "$(env_get AMC_TUNNEL_TOKEN "")" ] ||
      die "AMC_TUNNEL_TOKEN is not set in .env. Run ./amc public on $PUBLIC_HOST to enter it."
    # Docker publishes ports past the firewall (ufw): anything but
    # 127.0.0.1 would let browsers skip Cloudflare.
    [ "$BIND" = 127.0.0.1 ] ||
      warn "AMC_BIND is $BIND: port $PORT is reachable without going through Cloudflare. Set AMC_BIND=127.0.0.1 in .env."
  fi

  if [ "$(published_port)" != "$PORT" ]; then
    local who
    if who=$(port_in_use "$PORT"); then
      die "Port $PORT is already used by $who. Set another AMC_PORT in .env, then run ./amc start again."
    fi
  fi

  make_dirs "$DATA_DIR" "$DATA_DIR/MC-Projects"
  if login_mode; then
    # amc-auth and caddy keep their data in these. Made here, as the user:
    # on Linux, Docker would otherwise create them owned by root, and
    # amc-auth (running as the user) couldn't write its accounts database.
    make_dirs "$DATA_DIR/auth" "$DATA_DIR/caddy"
  fi
  check_readable
  write_version
  remove_appledouble

  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    say "First start: building the app. This downloads AMC and LaTeX (a few GB) and takes 10-30 minutes; later starts take seconds."
  fi
  say "Starting the AMC web app..."
  docker compose up -d --build --remove-orphans
  wait_ready
  if login_mode; then check_sandbox; fi
  if public_mode; then check_tunnel; fi

  if public_mode; then
    ok "AMC is running at https://$PUBLIC_HOST (sign-in required)"
  elif login_mode; then
    ok "AMC is running in shared-machine mode (sign-in required)"
  else
    ok "AMC is running at $URL"
  fi
  print_where
  if login_mode && [ "$(account_count)" = 0 ]; then
    warn "There are no accounts yet. Create the first admin with: ./amc user add <name> --admin"
  fi

  if [ "$OPEN_BROWSER" = 1 ]; then
    open_url "$URL" || echo "    Open $URL in your browser."
  fi
}

cmd_stop() {
  [ -f .env ] || { echo "Not set up yet, so nothing is running."; return 0; }
  ensure_docker
  docker compose down
  ok "Stopped. Your projects are kept."
}

cmd_status() {
  ensure_docker
  if [ ! -f .env ]; then echo "Not set up yet. Run ./amc start"; return 0; fi
  load_settings
  if login_mode; then export_sites; fi
  if is_running "$SERVICE"; then
    if public_mode; then ok "Running at https://$PUBLIC_HOST (sign-in required)"
    elif login_mode; then ok "Running in shared-machine mode (sign-in required)"
    else ok "Running at $URL"; fi
    if public_mode; then
      if tunnel_ready; then ok "Connected to Cloudflare"; else warn "The Cloudflare tunnel isn't connected: docker compose logs cloudflared"; fi
    fi
  else
    echo "Stopped. Start it with ./amc start"
  fi
  print_where
}

cmd_logs() {
  [ -f .env ] || die "Not set up yet. Run ./amc start"
  ensure_docker
  docker compose logs -f --tail 100
}

cmd_open() {
  [ -f .env ] || die "Not set up yet. Run ./amc start"
  load_settings
  open_url "$URL" || echo "Open $URL in your browser."
}

cmd_update() {
  command -v git >/dev/null 2>&1 || die "git is needed to update."
  git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 ||
    die "This copy isn't linked to a remote branch, so there is nothing to update from."
  [ -z "$(git status --porcelain --untracked-files=no)" ] ||
    die "This folder has uncommitted changes. Commit or stash them, then try again."
  say "Pulling the latest version..."
  git pull --ff-only
  cmd_start "$@"
}

cmd_import() {
  local user=""
  if [ "${1:-}" = --user ]; then
    [ $# -ge 2 ] || die "Usage: ./amc import --user NAME <project folder>..."
    user=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]'); shift 2  # accounts are lower-case
  fi
  [ $# -gt 0 ] || die "Usage: ./amc import [--user NAME] <project folder>..."
  ensure_env
  load_settings
  local base="$DATA_DIR/MC-Projects" src name dest
  if login_mode; then
    [ -n "$user" ] || die "In shared-machine mode, say whose projects these are: ./amc import --user NAME <folder>..."
    printf '%s' "$user" | grep -Eq '^[a-z0-9][a-z0-9._-]{1,31}$' ||
      die "Invalid username: $user (2 to 32 letters, digits, '.', '_' or '-', as for ./amc user add)"
    ensure_docker
    local uid gid abs
    uid=$(env_get AMC_UID 1000); gid=$(env_get AMC_GID 0)
    for src in "$@"; do
      src=${src%/}
      [ -d "$src" ] || die "Not a folder: $src"
      [ -f "$src/options.xml" ] || die "$src doesn't look like an AMC project (no options.xml inside)."
      abs=$(cd "$src" && pwd)
      name=${abs##*/}
      # shellcheck disable=SC2016  # expanded inside the container
      docker compose run --rm --no-deps -T -v "$abs:/from:ro" -e U="$user" -e N="$name" -e OWNER="$uid:$gid" \
        --entrypoint sh amc-home-init -c '
          dest=/amc-web/files/MC-Projects/$U/$N
          if [ -e "$dest" ]; then echo "exists"; exit 3; fi
          mkdir -p "${dest%/*}" && cp -a /from "$dest" && chown -R "$OWNER" "${dest%/*}"' ||
        die "Could not import $name (a project with that name may already exist for $user)."
      ok "Imported $name for $user"
    done
  else
    [ -z "$user" ] || die "--user only applies in shared-machine mode (./amc login on)."
    mkdir -p "$base"
    for src in "$@"; do
      src=${src%/}
      [ -d "$src" ] || die "Not a folder: $src"
      [ -f "$src/options.xml" ] || die "$src doesn't look like an AMC project (no options.xml inside)."
      name=$(basename "$src")
      dest="$base/$name"
      [ ! -e "$dest" ] || die "A project named '$name' already exists in $base"
      cp -R "$src" "$dest"
      ok "Imported $name"
    done
  fi
  echo "    The original folders are unchanged. Work on the copies in the web app:"
  echo "    its AMC is newer than desktop AMC 1.7.0."
}

# Projects from this-computer-only mode are in the host folder; shared-machine
# mode keeps one folder per teacher in a Docker volume. Copy them over (the
# originals stay where they are).
copy_single_user_projects() {
  local user=$1 root="$DATA_DIR/MC-Projects" d found=""
  for d in "$root"/*; do
    if [ -f "$d/options.xml" ]; then
      found="$found
      ${d##*/}"
    fi
  done
  [ -n "$found" ] || return 0
  echo "    Projects from this-computer-only mode:$found"
  if ! { [ -t 0 ] && confirm "    Copy them into $user's projects?"; }; then
    echo "    Not copied. Later: ./amc import --user $user <folder>"
    return 0
  fi
  local uid gid
  uid=$(env_get AMC_UID 1000); gid=$(env_get AMC_GID 0)
  # shellcheck disable=SC2016  # expanded inside the container
  docker compose run --rm --no-deps -T -v "$root:/from:ro" -e U="$user" -e OWNER="$uid:$gid" \
    --entrypoint sh amc-home-init -c '
      dest=/amc-web/files/MC-Projects/$U; mkdir -p "$dest"
      for d in /from/*; do
        [ -f "$d/options.xml" ] || continue
        n=${d##*/}
        if [ -e "$dest/$n" ]; then echo "    Skipped $n: already there."; else cp -a "$d" "$dest/$n"; fi
      done
      chown -R "$OWNER" "$dest"'
  ok "Copied into $user's projects. The originals are still in $root"
}

create_first_admin() {
  # Without a terminal, cmd_start's warning already says how to do it.
  [ -t 0 ] || return 0
  say "Create the first admin account. It can add the other teachers on the Admin page."
  local name=""
  while [ -z "$name" ]; do
    printf 'Admin username: '
    read -r name || return 1
  done
  auth_exec add "$name" --admin || return 1
  copy_single_user_projects "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
}

# The compose files the app runs with, from the settings in .env.
apply_compose_files() {
  local files=""
  if login_mode; then files=$LOGIN_FILES; fi
  if public_mode; then files="$files,$TUNNEL_FILE"; fi
  if [ "$(env_get AMC_PRINTER 0)" = 1 ]; then
    files="${files:-docker-compose.yml,docker-compose.override.yml},compose.printer.yml"
  fi
  if [ -n "$files" ]; then
    env_set COMPOSE_PATH_SEPARATOR ,
    env_set COMPOSE_FILE "$files"
  else
    env_unset COMPOSE_FILE
    env_unset COMPOSE_PATH_SEPARATOR
  fi
}

cups_socket() {
  local s
  for s in /run/cups/cups.sock /var/run/cups/cups.sock; do
    if [ -S "$s" ]; then printf '%s\n' "$s"; return 0; fi
  done
  return 1
}

printer_list() {
  local out
  if ! out=$(docker compose exec -T amc-web /venv/bin/python -c \
      'import cups; print(*sorted(cups.Connection().getPrinters()) or ["(none yet)"], sep="\n")' 2>&1); then
    warn "The app can't reach the print system: $out"
    return
  fi
  say "Printers the app can use:"
  printf '%s\n' "$out" | sed 's/^/  /'
}

cmd_printer() {
  local sub=${1:-status} sock
  [ $# -gt 0 ] && shift
  [ $# -eq 0 ] || die "Usage: ./amc printer on | off | status"
  case $sub in
    on)
      [ "$(uname -s)" = Linux ] || die "Direct printing only works when this machine runs Linux. Here, teachers save the PDFs in the Print step and print them from any computer."
      sock=$(cups_socket) || die "No print system (CUPS) found. Install CUPS, add the printer, then run ./amc printer on again."
      ensure_docker
      ensure_env
      say "Connecting the app to this machine's printers ($sock)."
      docker compose down >/dev/null 2>&1 || true
      env_set AMC_PRINTER 1
      env_set AMC_CUPS_SOCKET "$sock"
      apply_compose_files
      cmd_start --no-open
      printer_list
      ;;
    off)
      ensure_docker
      ensure_env
      docker compose down >/dev/null 2>&1 || true
      env_set AMC_PRINTER 0
      apply_compose_files
      cmd_start --no-open
      say "Direct printing is off: teachers save the PDFs and print them elsewhere."
      ;;
    status)
      ensure_env
      if [ "$(env_get AMC_PRINTER 0)" = 1 ]; then
        say "Direct printing is on."
        ensure_docker
        printer_list
      else
        say "Direct printing is off. Turn it on with ./amc printer on (Linux only)."
      fi
      ;;
    *) die "Usage: ./amc printer on | off | status" ;;
  esac
}

cmd_login() {
  local sub=${1:-} bind=0.0.0.0 a
  [ $# -gt 0 ] && shift
  case $sub in
    on)
      for a in "$@"; do
        case $a in --local) bind=127.0.0.1 ;; *) die "Unknown option: $a" ;; esac
      done
      ensure_docker
      ensure_env
      if login_mode; then
        say "Shared-machine mode is already on."
      else
        say "Turning on shared-machine mode: sign-in, HTTPS, one projects folder per teacher."
        docker compose down >/dev/null 2>&1 || true
        env_set AMC_LOGIN 1
        apply_compose_files
      fi
      if public_mode && [ "$bind" != 127.0.0.1 ]; then
        bind=127.0.0.1
        say "Public server mode is on: the server's own port stays reachable from this machine only."
      fi
      env_set AMC_BIND "$bind"
      cmd_start --no-open
      if [ "$(account_count)" = 0 ]; then create_first_admin; fi
      ;;
    off)
      [ $# -eq 0 ] || die "Unknown option: $1"
      ensure_docker
      ensure_env
      public_mode && die "The public address needs sign-in. Turn it off first: ./amc public off"
      if login_mode; then
        say "Turning off shared-machine mode: this computer only, no sign-in."
        docker compose down >/dev/null 2>&1 || true
      else
        say "Shared-machine mode is already off."
      fi
      env_set AMC_LOGIN 0
      apply_compose_files
      env_set AMC_BIND 127.0.0.1
      cmd_start --no-open
      warn "Teachers' projects stay in the Docker volume and come back with ./amc login on."
      ;;
    *) die "Usage: ./amc login on [--local] | ./amc login off" ;;
  esac
}

# HOST from "amc.example.org" or "https://amc.example.org/", lower-cased.
public_host_arg() {
  local h
  h=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  h=${h#https://}; h=${h#http://}; h=${h%/}
  printf '%s' "$h" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$' ||
    die "Give the address as a host name, e.g. ./amc public on amc.example.org (got '$1')."
  printf '%s' "$h"
}

# The tunnel token, typed (hidden) or piped in. Prompts go to stderr: the
# caller captures stdout.
read_tunnel_token() {
  local token=""
  if [ -t 0 ]; then
    say "Paste the tunnel's token (from 'cloudflared tunnel token NAME' or the Cloudflare dashboard). It isn't shown." >&2
    printf 'Tunnel token: ' >&2
    read -rs token || true
    echo >&2
  else
    read -r token || true
  fi
  token=$(printf '%s' "$token" | tr -d '[:space:]')
  case $token in ''|*[!A-Za-z0-9+/=_-]*) die "That doesn't look like a tunnel token." ;; esac
  printf '%s' "$token"
}

cmd_public() {
  local sub=${1:-status} host token a new_token=0
  [ $# -gt 0 ] && shift
  case $sub in
    on)
      [ $# -ge 1 ] || die "Usage: ./amc public on HOST [--new-token]"
      host=$(public_host_arg "$1")
      shift
      for a in "$@"; do
        case $a in --new-token) new_token=1 ;; *) die "Unknown option: $a" ;; esac
      done
      ensure_docker
      ensure_env
      if [ -z "$(env_get AMC_TUNNEL_TOKEN "")" ] || [ "$new_token" = 1 ]; then
        token=$(read_tunnel_token)
        env_set AMC_TUNNEL_TOKEN "$token"
      fi
      chmod 600 .env   # the token gives control of the tunnel
      say "Serving the app at https://$host through the Cloudflare tunnel (sign-in required)."
      docker compose down >/dev/null 2>&1 || true
      env_set AMC_LOGIN 1
      env_set AMC_PUBLIC_HOST "$host"
      env_set AMC_BIND 127.0.0.1
      apply_compose_files
      cmd_start --no-open
      if [ "$(account_count)" = 0 ]; then create_first_admin; fi
      ;;
    off)
      [ $# -eq 0 ] || die "Unknown option: $1"
      ensure_docker
      ensure_env
      if ! public_mode; then say "Public server mode is already off."; return 0; fi
      say "Stopping the public address. Sign-in stays on, reachable from this machine only."
      docker compose down >/dev/null 2>&1 || true
      env_unset AMC_PUBLIC_HOST
      apply_compose_files
      cmd_start --no-open
      ;;
    status)
      ensure_env
      load_settings
      if public_mode; then
        say "Public address: https://$PUBLIC_HOST"
        ensure_docker
        if tunnel_ready; then ok "Connected to Cloudflare"; else warn "The tunnel isn't connected: docker compose logs cloudflared"; fi
      else
        say "Public server mode is off. Turn it on with ./amc public on HOST"
      fi
      ;;
    *) die "Usage: ./amc public on HOST [--new-token] | off | status" ;;
  esac
}

cmd_user() {
  ensure_docker
  [ -f .env ] || die "Not set up yet. Run ./amc login on"
  login_mode || die "Accounts only exist in shared-machine mode. Turn it on with: ./amc login on"
  is_running amc-auth || die "The app isn't running. Start it with: ./amc start"
  [ $# -gt 0 ] || die "Usage: ./amc user add NAME [--admin] [--temporary] | passwd NAME | list | enable NAME"
  auth_exec "$@"
}

cmd_backup() {
  ensure_docker
  ensure_env
  load_settings
  local dir="$DATA_DIR/backups" name
  name="amc-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  mkdir -p "$dir"
  if login_mode; then
    # Projects from the volume, plus accounts and the certificate authority.
    mkdir -p "$DATA_DIR/auth" "$DATA_DIR/caddy"
    # busybox tar honours only one -C, so gather the three folders under
    # /stage with symlinks and follow them (-h).
    docker compose run --rm --no-deps -T -v "$dir:/backup" -v "$DATA_DIR/auth:/auth:ro" \
      -v "$DATA_DIR/caddy:/caddy:ro" --entrypoint sh amc-home-init -c "
        mkdir /stage && ln -s /amc-web/files/MC-Projects /stage/MC-Projects &&
        ln -s /auth /stage/auth && ln -s /caddy /stage/caddy &&
        tar czhf /backup/$name -C /stage MC-Projects auth caddy &&
        chmod 600 /backup/$name" ||
      { rm -f "$dir/$name"; die "The backup failed (messages above)."; }
  else
    if [ -d "$DATA_DIR/.AMC.d" ]; then
      tar czf "$dir/$name" -C "$DATA_DIR" MC-Projects .AMC.d
    else
      tar czf "$dir/$name" -C "$DATA_DIR" MC-Projects
    fi || { rm -f "$dir/$name"; die "The backup failed (messages above)."; }
    chmod 600 "$dir/$name"
  fi
  ok "Backup written to $dir/$name"
}

cmd_cert() {
  ensure_env
  load_settings
  login_mode || die "HTTPS is only used in shared-machine mode (./amc login on)."
  local ca="$DATA_DIR/caddy/caddy/pki/authorities/local/root.crt" out="$DATA_DIR/amc-ca.crt"
  if [ -r "$ca" ]; then
    cp "$ca" "$out"
  else
    # On Linux, caddy's files belong to root (caddy runs as root in its
    # container), so read the certificate through the container.
    ensure_docker
    is_running caddy || die "There is no certificate yet. Start the app once with ./amc start"
    if ! docker compose exec -T caddy cat /data/caddy/pki/authorities/local/root.crt > "$out" 2>/dev/null ||
       [ ! -s "$out" ]; then
      rm -f "$out"
      die "There is no certificate yet. Start the app once with ./amc start"
    fi
  fi
  LAN_IP=$(lan_address)
  cat <<EOF
The app's HTTPS certificate comes from its own certificate authority:
    $DATA_DIR/amc-ca.crt
Colleagues can also download it from https://${LAN_IP:-localhost}:$PORT/amc-ca.crt
(the browser warns once before the download).

Install it once on each computer so browsers trust the app:
  macOS:    double-click it to add it to the login keychain, open it in
            Keychain Access and set "When using this certificate" to "Always Trust".
  Windows:  double-click it > Install Certificate > Current User >
            Place in "Trusted Root Certification Authorities".
  Linux:    sudo cp amc-ca.crt /usr/local/share/ca-certificates/amc-ca.crt
            sudo update-ca-certificates
  Firefox may keep its own list: Settings > Privacy & Security > Certificates >
            View Certificates > Authorities > Import.
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  start)          cmd_start "$@" ;;
  stop)           cmd_stop ;;
  restart)        cmd_stop; cmd_start "$@" ;;
  status)         cmd_status ;;
  logs)           cmd_logs ;;
  open)           cmd_open ;;
  update)         cmd_update "$@" ;;
  import)         cmd_import "$@" ;;
  login)          cmd_login "$@" ;;
  public)         cmd_public "$@" ;;
  user)           cmd_user "$@" ;;
  cert)           cmd_cert ;;
  backup)         cmd_backup ;;
  printer)        cmd_printer "$@" ;;
  help|-h|--help) usage ;;
  *)              usage >&2; exit 1 ;;
esac
