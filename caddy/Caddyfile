# Entry point of the AMC web app in shared-machine mode (compose.login.yml).
# Caddy is the only container with a published port: it serves HTTPS with
# its own certificate authority and asks amc-auth who is signed in before
# passing a request to AMC.
#
# AMC_SITES:       https://<name>:<port> addresses to serve, comma separated
#                  (the launcher lists localhost, the LAN address and host name)
# AMC_DEFAULT_SNI: certificate name for browsers that connect by IP address
#                  and so don't send a server name
#
# On a public server (./amc public on), compose.tunnel.yml adds the site in
# caddy/tunnel/, which serves the same routes to a Cloudflare tunnel.

{
	admin off
	skip_install_trust
	auto_https disable_redirects
	default_sni {$AMC_DEFAULT_SNI:localhost}
}

# What every site serves. {args[0]} is the visitor's IP address: AMC and
# amc-auth receive it as X-Forwarded-For (amc-auth limits failed sign-ins
# per address).
(amc) {
	# AMC trusts these headers as the signed-in user and whether they are
	# an admin, so they must only ever come from amc-auth, never from a
	# browser.
	request_header -X-AMC-User
	request_header -X-AMC-Admin

	# Colleagues download the certificate authority here, to make their
	# browsers trust this server's certificate.
	handle /amc-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=amc-ca.crt"
		file_server
	}

	handle /auth/* {
		reverse_proxy amc-auth:8000 {
			header_up X-Forwarded-For {args[0]}
			header_up X-Forwarded-Proto https
		}
	}

	# Shareable marks links. AMC serves these only for projects whose owner
	# turned them on, and they work without signing in, as upstream intends.
	handle /public/* {
		reverse_proxy amc-web:8080 {
			header_up X-Forwarded-For {args[0]}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		forward_auth amc-auth:8000 {
			uri /auth/verify
			copy_headers X-AMC-User X-AMC-Admin
			# The sign-in check is a plain request even when the browser
			# opens a websocket; the auth service rejects upgrade requests.
			header_up -Connection
			header_up -Upgrade
		}
		reverse_proxy amc-web:8080 {
			header_up X-Forwarded-For {args[0]}
			header_up X-Forwarded-Proto https
		}
	}

	# Exams, scans and marks belong to the signed-in teacher: a shared cache
	# (Cloudflare, on a public server) must not keep them, and two teachers
	# with an exam of the same name get the same file addresses. Only the
	# app's static files, whose names change with their content, may be
	# cached. amc-auth's pages already say no-store.
	@private not path /static/* /auth/*
	header @private {
		Cache-Control "private, no-cache"
		defer
	}

	header -Server
}

{$AMC_SITES:https://localhost:8090} {
	tls internal
	import amc {client_ip}
}

# Sites added by compose.tunnel.yml (caddy/tunnel/); none otherwise.
import /etc/caddy-extra/*.caddy
